# ─── App ─────────────────────────────────────────────────────
APP_NAME="SmartCourt AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── CORS (frontend dev) ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=smartcourt
POSTGRES_PASSWORD=smartcourt_secret
POSTGRES_DB=smartcourt
DATABASE_URL=postgresql+asyncpg://smartcourt:smartcourt_secret@postgres:5432/smartcourt

# ─── Ollama (host) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.3

# ─── Qdrant ──────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_LAWS_COLLECTION=uz_laws
QDRANT_PRECEDENTS_COLLECTION=uz_precedents
EMBED_DIM=768

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Neo4j (optional, CorruptAlert) ──────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=smartcourt_graph

# ─── Whisper (JustiScribe) ───────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=uz

# ─── Storage ─────────────────────────────────────────────────
STORAGE_DIR=/code/storage
MAX_UPLOAD_MB=50
